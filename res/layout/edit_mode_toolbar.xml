<com.android.launcher3.views.EditModeToolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edit_mode_toolbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dynamic_grid_drop_target_size"
    android:layout_gravity="center_horizontal|top"
    android:background="@drawable/bg_widgets_full_sheet"
    android:elevation="4dp"
    android:visibility="gone"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btn_dismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:src="@drawable/ic_remove_no_shadow"
        android:contentDescription="@android:string/cancel"
        android:background="@drawable/edit_mode_toolbar_button_bg"
        android:scaleType="center"
        android:tint="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/selection_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="18sp"
        android:textColor="?android:attr/textColorPrimary"
        android:text="0 selected"
        android:fontFamily="variable-title-medium" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_create_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:src="@drawable/ic_folder_add"
            android:contentDescription="@string/folder_hint_text"
            android:background="@drawable/edit_mode_toolbar_button_bg"
            android:scaleType="center"
            android:tint="?android:attr/textColorPrimary"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Done"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:background="@drawable/edit_mode_toolbar_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="variable-title-medium" />

    </LinearLayout>
</com.android.launcher3.views.EditModeToolbar>
