<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/universal_search_card_margin_horizontal"
    android:layout_marginEnd="@dimen/universal_search_card_margin_horizontal"
    android:background="@drawable/universal_search_action_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/universal_search_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/universal_search_card_padding"
        android:paddingEnd="@dimen/universal_search_card_padding">

        <FrameLayout
            android:id="@+id/search_action_icon_container"
            android:layout_width="@dimen/universal_search_icon_container_size"
            android:layout_height="@dimen/universal_search_icon_container_size"
            android:layout_marginEnd="@dimen/universal_search_card_padding"
            android:background="@drawable/universal_search_icon_background"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/search_action_icon"
                android:layout_width="@dimen/universal_search_icon_size"
                android:layout_height="@dimen/universal_search_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/search_action_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="variable-body-large"
                android:lineHeight="24sp"
                android:maxLines="1"
                android:textColor="@color/materialColorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/search_action_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="variable-body-medium"
                android:lineHeight="20sp"
                android:maxLines="1"
                android:textColor="@color/materialColorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/search_action_thumbnail_container"
            android:layout_width="@dimen/universal_search_thumbnail_width"
            android:layout_height="@dimen/universal_search_thumbnail_height"
            android:layout_marginStart="@dimen/universal_search_section_icon_margin_end"
            android:background="@drawable/universal_search_icon_background"
            android:clipToOutline="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/search_action_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <ImageView
            android:id="@+id/search_action_end_icon"
            android:layout_width="@dimen/universal_search_section_icon_size"
            android:layout_height="@dimen/universal_search_section_icon_size"
            android:layout_marginStart="@dimen/universal_search_card_padding"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_end"
            android:tint="@color/materialColorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
